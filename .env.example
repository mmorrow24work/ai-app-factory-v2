# Local secrets store for scripts/factory-new.sh and scripts/factory-secrets.sh.
# Copy to .env (gitignored -- never committed) and fill in real values.
#
# GH_PAT is deliberately NOT here -- factory-secrets.sh prompts for it fresh, input hidden,
# every run. See DESIGN.md's "GH_PAT: token strategy" for why: a single .env-stored GH_PAT
# reused across every generated project means one leak exposes all of them.

# Mint with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Optional defaults consumed by scripts/factory-new.sh's --set placeholders when a project
# type needs them and none is passed explicitly on the command line.
NAUTOBOT_VERSION=^3.0.0
NETBOX_VERSION=v4.5.0
